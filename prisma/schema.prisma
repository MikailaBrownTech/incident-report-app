generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Better Auth (global, NOT tenant-scoped) ----------
// Field names follow Better Auth's core schema; keep in sync when upgrading it.
model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  memberships   Membership[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------- Tenancy ----------
enum Plan {
  FREE
  TEAM
  BUSINESS
}

enum Skin {
  HAUNTED
  PROFESSIONAL
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  plan               Plan     @default(FREE)
  stripeCustomerId   String? // billing stub
  skin               Skin     @default(HAUNTED)
  severityLabels     Json? // {"1": "Custom name", ...} overrides skin defaults
  nextIncidentNumber Int      @default(1) // atomically incremented per workspace
  createdAt          DateTime @default(now())

  memberships         Membership[]
  invites             Invite[]
  services            Service[]
  incidents           Incident[]
  integrations        Integration[]
  retroRules          RetroRule[]
  postmortemTemplates PostmortemTemplate[]
  auditLogs           AuditLog[]
}

model Membership {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        Role      @default(MEMBER)
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignments IncidentAssignment[]

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        Role      @default(MEMBER)
  tokenHash   String    @unique // sha256 of the emailed token; the raw token is never stored
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime? // soft revoke so the link shows a friendly "revoked" page, not "not found"
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
}

// ---------- Incidents ----------
enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MITIGATING
  RESOLVED
}

enum IncidentRole {
  COMMANDER
  SCRIBE
  COMMS
}

model Service {
  id          String            @id @default(cuid())
  workspaceId String
  name        String
  slug        String // generated from the name, unique per workspace, stable across renames
  createdAt   DateTime          @default(now())
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  incidents   IncidentService[]

  @@unique([workspaceId, name])
  @@unique([workspaceId, slug])
  @@unique([id, workspaceId])
}

model Incident {
  id           String         @id @default(cuid())
  workspaceId  String
  number       Int // per-workspace sequence
  title        String
  summary      String         @default("")
  severity     Int // 1..5, 5 = most severe
  status       IncidentStatus @default(INVESTIGATING)
  startedAt    DateTime       @default(now())
  resolvedAt   DateTime? // set on RESOLVED, cleared on reopen; MTTR source
  revenantOfId String?
  createdById  String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime? // soft delete; scopedDb hides these rows everywhere
  seedKey      String? // set only by `pnpm seed:mine` (slug of the fixture title); null for real incidents

  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  revenantOf  Incident?            @relation("Revenant", fields: [revenantOfId], references: [id], onDelete: SetNull)
  revenants   Incident[]           @relation("Revenant")
  services    IncidentService[]
  assignments IncidentAssignment[]
  events      Event[]
  postmortem  Postmortem?
  actionItems ActionItem[]
  dismissals  RevenantDismissal[]  @relation("DismissalIncident")
  dismissedAs RevenantDismissal[]  @relation("DismissalCandidate")

  @@unique([workspaceId, number])
  @@unique([workspaceId, seedKey])
  @@unique([id, workspaceId])
  @@index([revenantOfId])
  @@index([workspaceId, status])
  @@index([workspaceId, startedAt])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "incident_title_trgm")
}

model IncidentService {
  incidentId  String
  serviceId   String
  workspaceId String
  incident    Incident @relation(fields: [incidentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  service     Service  @relation(fields: [serviceId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@id([incidentId, serviceId])
  @@index([workspaceId, serviceId])
}

model IncidentAssignment {
  id          String       @id @default(cuid())
  workspaceId String
  incidentId  String
  userId      String
  role        IncidentRole
  incident    Incident     @relation(fields: [incidentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  member      Membership   @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)

  @@unique([incidentId, role]) // one holder per role
  @@index([workspaceId, userId])
}

// ---------- Events (timeline; webhook-ready) ----------
// USER = entered by a person (notes and the changes they make), SYSTEM = automatic, INTEGRATION = webhook, SLACK = Slack.
enum EventSource {
  USER
  SYSTEM
  INTEGRATION
  SLACK
}

enum EventType {
  NOTE
  STATUS_CHANGED
  SEVERITY_CHANGED
  TITLE_CHANGED
  SUMMARY_CHANGED
  INCIDENT_DELETED
  ROLE_ASSIGNED
  ROLE_UNASSIGNED
  SERVICES_CHANGED
  REVENANT_LINKED
  REVENANT_UNLINKED
  POSTMORTEM_PUBLISHED
  RITUAL_CREATED
  RITUAL_COMPLETED
  POSTMORTEM_STARTED
  POSTMORTEM_UNPUBLISHED
  RETRO_OVERRIDE
  EXTERNAL // catch-all for webhook payloads
}

model Event {
  id            String      @id @default(cuid())
  workspaceId   String
  incidentId    String
  type          EventType
  source        EventSource @default(USER)
  actorId       String? // null for system/integration; kept as a plain id so history survives member removal
  body          String?
  payload       Json        @default("{}")
  occurredAt    DateTime    @default(now()) // when it happened (may be backdated)
  createdAt     DateTime    @default(now()) // when we recorded it
  integrationId String?
  externalId    String? // idempotency key for webhook ingestion
  editedAt      DateTime? // set when a note's text or time is edited
  updatedAt     DateTime    @default(now()) @updatedAt // any change at all (edit, star): lets live refresh spot it
  isKeyMoment   Boolean     @default(false) // pulled into postmortems in a later milestone
  incident      Incident    @relation(fields: [incidentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([integrationId, externalId])
  @@index([workspaceId, incidentId, occurredAt])
  @@index([incidentId, occurredAt, id]) // timeline paging: ordered by when it happened, id breaks ties
}

// Extension point for Slack / PagerDuty / etc. Unused in v1.
model Integration {
  id          String    @id @default(cuid())
  workspaceId String
  kind        String
  config      Json      @default("{}")
  secretHash  String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ---------- Postmortems & rituals ----------
enum PostmortemStatus {
  DRAFT
  PUBLISHED
}

model Postmortem {
  id            String              @id @default(cuid())
  workspaceId   String
  incidentId    String              @unique
  status        PostmortemStatus    @default(DRAFT)
  publishedAt   DateTime?
  authorId      String
  // Plain ids, like every actor: history survives a member leaving.
  publishedById String?
  templateId    String
  /// { sections: { [key]: Tiptap doc } }; validated against an allowlist on every write (features/postmortems/content.ts)
  content       Json                @default("{\"sections\":{}}")
  /// Compare-and-set counter for autosave: a save must send the version it loaded, and every save increments it.
  version       Int                 @default(1)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  incident      Incident            @relation(fields: [incidentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  template      PostmortemTemplate  @relation(fields: [templateId], references: [id])
  // Superseded by `content` in M4; kept (unused) so no data migration was needed.
  sections      PostmortemSection[]
  rituals       ActionItem[]

  @@unique([id, workspaceId])
  @@unique([incidentId, workspaceId])
  @@index([workspaceId, status])
}

model PostmortemSection {
  id           String     @id @default(cuid())
  workspaceId  String
  postmortemId String
  key          String // CAUSE | LAST_SIGHTING | WITNESSES | LEARNED
  content      Json // Tiptap document
  position     Int
  postmortem   Postmortem @relation(fields: [postmortemId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([postmortemId, key])
}

enum ActionStatus {
  OPEN
  IN_PROGRESS
  DONE
  WONT_DO
}

// "Ritual" in the haunted skin.
model ActionItem {
  id               String       @id @default(cuid())
  workspaceId      String
  postmortemId     String
  incidentId       String // denormalised from the postmortem, for fast filtering and to hide soft-deleted incidents' items
  title            String
  description      String       @default("")
  ownerId          String // plain id so finished rituals keep their history after a member leaves; validated as a current member on write
  createdById      String
  dueDate          DateTime?    @db.Date // a calendar date, no time
  status           ActionStatus @default(OPEN)
  wontDoReason     String?
  completedAt      DateTime?
  /// Fractional-indexing key ordering cards within a status column (byte order: the column is COLLATE "C" in the migration).
  position         String       @default("a0")
  externalProvider String? // extension point for Jira / Linear / Asana sync; unused
  externalUrl      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt
  postmortem       Postmortem   @relation(fields: [postmortemId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  incident         Incident     @relation(fields: [incidentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, status, dueDate]) // overdue = open or in progress AND dueDate < today
  @@index([ownerId, status])
  @@index([postmortemId])
  @@index([workspaceId, status, position])
}

// "Not a match": remembers that a person decided candidate X is not a recurrence of incident Y, so it stops being suggested.
model RevenantDismissal {
  id            String   @id @default(cuid())
  workspaceId   String
  incidentId    String
  candidateId   String
  dismissedById String // plain id, like every actor: history survives a member leaving
  createdAt     DateTime @default(now())
  incident      Incident @relation("DismissalIncident", fields: [incidentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  candidate     Incident @relation("DismissalCandidate", fields: [candidateId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([incidentId, candidateId])
  @@index([workspaceId])
}

// OFF and RECOMMENDED predate M4 and are migrated to OPTIONAL; the app only uses REQUIRED, OPTIONAL and SKIP.
enum RetroRuleMode {
  OFF
  RECOMMENDED
  REQUIRED
  OPTIONAL
  SKIP
}

// A workspace has one rule per severity threshold; an incident follows the rule with the highest minSeverity <= its severity.
model RetroRule {
  id          String        @id @default(cuid())
  workspaceId String
  minSeverity Int           @default(4) // applies to incidents at this severity or higher
  mode        RetroRuleMode @default(REQUIRED)
  dueInDays   Int           @default(5) // days after resolution that a required postmortem is due
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, minSeverity])
}

// Postmortem structure. Built-in templates have a null workspaceId (invisible to scopedDb; read through db/root.ts).
model PostmortemTemplate {
  id          String       @id @default(cuid())
  workspaceId String?
  name        String
  isSystem    Boolean      @default(false)
  isDefault   Boolean      @default(false)
  sections    Json // [{ key, required, order }]; built-in titles and blameless prompts come from the copy dictionary
  createdAt   DateTime     @default(now())
  workspace   Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  postmortems Postmortem[]

  @@index([workspaceId])
}

// Append-only record of security-relevant changes (who did what to whom, and when).
model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  actorId     String? // plain id: history survives a member leaving
  action      String // e.g. "member.role_changed"
  targetType  String
  targetId    String
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

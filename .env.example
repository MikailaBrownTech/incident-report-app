# Neon (https://neon.tech). Copy the connection strings from the Neon console.
# App runtime: the POOLED connection string (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Prisma migrations and the test harness: the DIRECT (non-pooled) connection string.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Better Auth (email magic link; no social providers)
BETTER_AUTH_SECRET=""     # generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Public base URL of the app: used in emailed links and by Better Auth.
APP_URL="http://localhost:3000"

# Email. With RESEND_API_KEY set, mail goes through Resend. Without it (development only)
# magic links and invites are printed to the server console and saved to .dev-outbox/.
RESEND_API_KEY=""
EMAIL_FROM="The Crypt <onboarding@resend.dev>"

# AI summaries (optional). Without a key the "Draft with AI" button reports that AI is not set up.
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5-5"
